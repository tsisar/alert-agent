package templates

func routeAddress(activePage string) string {
	switch activePage {
	case "scenarios":
		return "PANEL / SCENARIOS"
	case "scenario-form":
		return "PANEL / SCENARIOS / EDITOR"
	case "prompts":
		return "PANEL / PROMPTS"
	default:
		return "PANEL"
	}
}

func navKey(activePage string) string {
	if activePage == "scenario-form" {
		return "scenarios"
	}
	return activePage
}

templ Layout(title, activePage string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<title>{ title } — Alert Agent</title>
			<link rel="preload" href="/static/fonts/overpass-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="preload" href="/static/fonts/overpass-mono-latin.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/panel.js" defer></script>
			<script>
				(function () {
					try {
						var t = localStorage.getItem("theme");
						if (t !== "dark" && t !== "light") {
							t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
						}
						document.documentElement.setAttribute("data-theme", t);
					} catch (e) {}
				})();
			</script>
		</head>
		<body>
			<header class="shell-head">
				<nav class="shell-head-inner" aria-label="Primary">
					<a href="/scenarios" class="brand">
						@signalMark()
						Alert Agent
					</a>
					<span class="brand-rule" aria-hidden="true"></span>
					<span class="route-address">{ routeAddress(activePage) }</span>
					<ul class="shell-nav">
						<li>
							if navKey(activePage) == "scenarios" {
								<a href="/scenarios" aria-current="page">Scenarios</a>
							} else {
								<a href="/scenarios">Scenarios</a>
							}
						</li>
						<li>
							if navKey(activePage) == "prompts" {
								<a href="/prompts" aria-current="page">Prompts</a>
							} else {
								<a href="/prompts">Prompts</a>
							}
						</li>
					</ul>
					<button
						type="button"
						class="icon-button"
						data-theme-toggle
						aria-label="Switch to dark theme"
						title="Switch theme"
					>
						@sunIcon()
						@moonIcon()
					</button>
				</nav>
			</header>
			<main class="shell-main">
				{ children... }
			</main>
		</body>
	</html>
}

templ PageHead(title, lede string) {
	<div class="page-head">
		<div>
			<h1 class="page-title">{ title }</h1>
			if lede != "" {
				<p class="page-lede">{ lede }</p>
			}
		</div>
		<div class="page-head-actions">
			{ children... }
		</div>
	</div>
}

// Notice renders a standing message. level is "info", "warn" or "error".
templ Notice(level, message string) {
	<div class="notice" data-level={ level } role="status" aria-live="polite">
		if level == "error" {
			@alertIcon()
		} else {
			@infoIcon()
		}
		<span>{ message }</span>
	</div>
}

templ signalMark() {
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<path d="M1.5 18.5h6.2L10.6 5l3.1 8.4 2-3.4h6.8"></path>
		<rect x="18.4" y="8" width="3.4" height="3.4" fill="currentColor" stroke="none"></rect>
	</svg>
}

templ sunIcon() {
	<svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<circle cx="12" cy="12" r="4.2"></circle>
		<path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2M22 12h-2.2M6.3 6.3 4.8 4.8M19.2 19.2l-1.5-1.5M17.7 6.3l1.5-1.5M4.8 19.2l1.5-1.5"></path>
	</svg>
}

templ moonIcon() {
	<svg class="icon-moon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<path d="M20.5 13.4A8.4 8.4 0 0 1 10.6 3.5a8.4 8.4 0 1 0 9.9 9.9z"></path>
	</svg>
}

templ infoIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<rect x="3.5" y="3.5" width="17" height="17"></rect>
		<path d="M12 10.6v6M12 7.4v1.4"></path>
	</svg>
}

templ alertIcon() {
	<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<path d="M12 3.4 2.4 20.6h19.2z"></path>
		<path d="M12 9.6v5M12 17.4v1"></path>
	</svg>
}

templ spinnerIcon() {
	<svg class="spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
		<path d="M12 3.2a8.8 8.8 0 1 0 8.8 8.8" opacity="0.9"></path>
	</svg>
}
