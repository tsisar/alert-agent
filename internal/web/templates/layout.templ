package templates

func navKey(activePage string) string {
	if activePage == "scenario-form" {
		return "scenarios"
	}
	return activePage
}

templ Layout(title, activePage string) {
	<!DOCTYPE html>
	<html lang="en" data-theme="light">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<title>{ title } — Alert Agent</title>
			<link rel="stylesheet" href="/static/app.css"/>
			<script src="/static/htmx.min.js"></script>
			<script src="/static/panel.js" defer></script>
			<script>
				(function () {
					try {
						var t = localStorage.getItem("theme");
						if (t !== "dark" && t !== "light") {
							t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
						}
						document.documentElement.setAttribute("data-theme", t);
					} catch (e) {}
				})();
			</script>
		</head>
		<body>
			<header class="topbar">
				<div class="topbar-inner">
					<a href="/scenarios" class="brand">
						@brandMark()
						<span>Alert Agent</span>
					</a>
					<nav class="topnav" aria-label="Primary">
						if navKey(activePage) == "scenarios" {
							<a href="/scenarios" aria-current="page">Scenarios</a>
						} else {
							<a href="/scenarios">Scenarios</a>
						}
						if navKey(activePage) == "prompts" {
							<a href="/prompts" aria-current="page">Prompts</a>
						} else {
							<a href="/prompts">Prompts</a>
						}
					</nav>
					<button
						type="button"
						class="btn btn-icon btn-ghost topbar-theme"
						data-theme-toggle
						aria-label="Switch to dark theme"
						title="Switch theme"
					>
						@sunIcon()
						@moonIcon()
					</button>
				</div>
			</header>
			<main class="page">
				{ children... }
			</main>
		</body>
	</html>
}

templ PageHead(title, lede string) {
	<div class="page-head">
		<div class="page-head-text">
			<h1 class="page-title">{ title }</h1>
			if lede != "" {
				<p class="page-lede">{ lede }</p>
			}
		</div>
		<div class="page-head-actions">
			{ children... }
		</div>
	</div>
}

// Notice renders a standing message. level is "info", "warn" or "error".
templ Notice(level, message string) {
	<div class="notice" data-level={ level } role="status" aria-live="polite">
		if level == "error" || level == "warn" {
			@alertIcon()
		} else {
			@infoIcon()
		}
		<span>{ message }</span>
	</div>
}

// --- icons -----------------------------------------------------------------
// One family: 24px grid, 1.75 stroke, round caps, drawn at 16px.

// brandMark is the same file as the favicon, so the tab and the header always
// show one icon.
templ brandMark() {
	<img class="brand-mark" src="/static/favicon.svg" width="24" height="24" alt=""/>
}

templ sunIcon() {
	<svg class="icon icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M6.6 6.6 5.2 5.2M18.8 18.8l-1.4-1.4M17.4 6.6l1.4-1.4M5.2 18.8l1.4-1.4"></path>
	</svg>
}

templ moonIcon() {
	<svg class="icon icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M20.5 13.4A8.4 8.4 0 0 1 10.6 3.5a8.4 8.4 0 1 0 9.9 9.9z"></path>
	</svg>
}

templ infoIcon() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
		<circle cx="12" cy="12" r="9"></circle>
		<path d="M12 11v5.5M12 7.6v.4"></path>
	</svg>
}

templ alertIcon() {
	<svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
