package templates

import "github.com/tsisar/alert-agent/internal/storage"

type promptStage struct {
	Key   string
	Label string
	Note  string
	Value string
}

func promptStages(p *storage.PromptSet) []promptStage {
	return []promptStage{
		{
			Key:   "system",
			Label: "System",
			Note:  "Sent before every investigation. Sets the agent's role, its limits and the shape of the report.",
			Value: p.System,
		},
		{
			Key:   "summary",
			Label: "Summary",
			Note:  "Turns a finished investigation into the message that reaches Telegram or Slack.",
			Value: p.Summary,
		},
		{
			Key:   "resolved",
			Label: "Resolved",
			Note:  "Used when an alert stops firing, so the thread is closed rather than left open.",
			Value: p.Resolved,
		},
		{
			Key:   "paused",
			Label: "Paused",
			Note:  "Used when an investigation is cut short — the timeout elapsed or the tool budget ran out.",
			Value: p.Paused,
		},
	}
}

templ PromptsPage(prompts *storage.PromptSet) {
	@Layout("Prompts", "prompts") {
		@PageHead("Prompts", "Four templates shared by every scenario. A scenario's own instructions are added to the System prompt. Saved changes apply to the next alert.") {
		}
		<div class="tabs" role="tablist" aria-label="Prompt templates" data-tabs>
			for _, stage := range promptStages(prompts) {
				<a
					href={ templ.SafeURL("#prompt-" + stage.Key) }
					role="tab"
					class="tab"
					id={ "tab-" + stage.Key }
					aria-controls={ "prompt-" + stage.Key }
					data-tab={ "prompt-" + stage.Key }
				>
					{ stage.Label }
					<span class="tab-dot" aria-hidden="true"></span>
				</a>
			}
		</div>
		<div class="stage-list">
			for _, stage := range promptStages(prompts) {
				@PromptStage(stage, false)
			}
		</div>
	}
}

templ PromptStage(stage promptStage, saved bool) {
	<article
		class="card stage"
		id={ "prompt-" + stage.Key }
		role="tabpanel"
		aria-labelledby={ "tab-" + stage.Key }
		data-stage
		data-saved={ boolAttr(saved) }
	>
		<form
			hx-put={ "/prompts/" + stage.Key }
			hx-target={ "#prompt-" + stage.Key }
			hx-swap="outerHTML"
		>
			<header class="form-card-head">
				<div>
					<h2 class="card-title">{ stage.Label }</h2>
					<p class="muted">{ stage.Note }</p>
				</div>
				<span class="badge" data-stage-state data-state="clean" aria-live="polite">Saved</span>
			</header>
			<div class="form-card-body">
				<textarea
					aria-label={ stage.Label + " prompt template" }
					id={ "prompt-field-" + stage.Key }
					name="value"
					class="mono prompt-area"
					rows="12"
					data-autoresize
					spellcheck="false"
				>{ stage.Value }</textarea>
			</div>
			<footer class="form-card-foot">
				<button type="button" class="btn" data-stage-revert disabled>Discard changes</button>
				<button type="submit" class="btn btn-primary" data-stage-save disabled>
					<span class="btn-idle">Save</span>
					<span class="btn-working">
						@spinnerIcon()
						Saving…
					</span>
				</button>
			</footer>
		</form>
	</article>
}

// PromptStageSaved re-renders one stage after a successful save.
templ PromptStageSaved(key, value string) {
	@PromptStage(promptStageByKey(key, value), true)
}

func promptStageByKey(key, value string) promptStage {
	for _, s := range promptStages(&storage.PromptSet{}) {
		if s.Key == key {
			s.Value = value
			return s
		}
	}
	return promptStage{Key: key, Label: key, Value: value}
}

func boolAttr(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
