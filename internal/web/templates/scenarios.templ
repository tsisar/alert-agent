package templates

import (
	"fmt"
	"sort"
	"strings"

	"github.com/tsisar/alert-agent/internal/storage"
)

// --- helpers ---------------------------------------------------------------

type labelPair struct {
	Key   string
	Value string
}

// matchPairs returns the match labels in a stable order.
func matchPairs(m storage.JSONMap) []labelPair {
	pairs := make([]labelPair, 0, len(m))
	for k, v := range m {
		pairs = append(pairs, labelPair{Key: k, Value: v})
	}
	sort.Slice(pairs, func(i, j int) bool { return pairs[i].Key < pairs[j].Key })
	return pairs
}

func matchText(m storage.JSONMap) string {
	pairs := matchPairs(m)
	lines := make([]string, 0, len(pairs))
	for _, p := range pairs {
		lines = append(lines, p.Key+"="+p.Value)
	}
	return strings.Join(lines, "\n")
}

func priorityKey(p string) string {
	switch p {
	case "critical", "high":
		return p
	default:
		return "normal"
	}
}

func priorityLabel(p string) string {
	switch priorityKey(p) {
	case "critical":
		return "Critical"
	case "high":
		return "High"
	default:
		return "Normal"
	}
}

func countByPriority(scenarios []storage.Scenario, p string) int {
	n := 0
	for _, s := range scenarios {
		if priorityKey(s.Priority) == p {
			n++
		}
	}
	return n
}

func countCatchAll(scenarios []storage.Scenario) int {
	n := 0
	for _, s := range scenarios {
		if len(s.Match) == 0 {
			n++
		}
	}
	return n
}

// promptPreview trims the prompt to a single scannable line.
func promptPreview(s string) string {
	line := strings.TrimSpace(strings.ReplaceAll(strings.ReplaceAll(s, "\r", " "), "\n", " "))
	for strings.Contains(line, "  ") {
		line = strings.ReplaceAll(line, "  ", " ")
	}
	const limit = 96
	if len(line) > limit {
		return strings.TrimSpace(line[:limit]) + "…"
	}
	return line
}

// searchIndex is the haystack the client-side filter matches against.
func searchIndex(s storage.Scenario) string {
	parts := []string{s.Name, s.Priority, s.Timeout, s.ChannelTelegram, s.ChannelSlack}
	for _, p := range matchPairs(s.Match) {
		parts = append(parts, p.Key+"="+p.Value)
	}
	parts = append(parts, []string(s.Tools)...)
	if len(s.Match) == 0 {
		parts = append(parts, "catch-all")
	}
	return strings.ToLower(strings.Join(parts, " "))
}

// toolsSummary is read under an engraved TOOLS label, so it carries the value
// only: "all" or a count.
func toolsSummary(s storage.Scenario) string {
	if len(s.Tools) == 0 {
		return "all"
	}
	return fmt.Sprint(len(s.Tools))
}

func destinations(s storage.Scenario) []labelPair {
	out := []labelPair{}
	if s.ChannelTelegram != "" {
		out = append(out, labelPair{Key: "telegram", Value: s.ChannelTelegram})
	}
	if s.ChannelSlack != "" {
		out = append(out, labelPair{Key: "slack", Value: s.ChannelSlack})
	}
	return out
}

// --- scenario field --------------------------------------------------------

templ ScenariosPage(scenarios []storage.Scenario) {
	@Layout("Scenarios", "scenarios") {
		@PageHead("Signal panel", "Every alert enters at the top and takes the first path that matches it. Paths are evaluated in the order shown.") {
			<a href="/scenarios/export.yaml" role="button" class="btn btn-sm" download="scenarios.yaml">Export YAML</a>
			<button type="button" class="btn btn-sm" onclick="document.getElementById('import-file').click()">Import YAML</button>
			<form
				id="import-form"
				hx-post="/scenarios/import"
				hx-target="body"
				hx-push-url="/scenarios"
				hx-encoding="multipart/form-data"
				hidden
			>
				<input
					type="file"
					id="import-file"
					name="file"
					accept=".yaml,.yml"
					onchange="if(this.files.length){htmx.trigger(this.closest('form'),'submit');this.value=''}"
				/>
			</form>
		}
		<form class="strip" data-probe-form>
			<div class="readout">
				<div class="readout-cell">
					<span class="engraved">Paths</span>
					<span class="readout-value">{ fmt.Sprint(len(scenarios)) }</span>
				</div>
				<div class="readout-cell" data-mark="critical">
					<span class="engraved">Critical</span>
					<span class="readout-value">{ fmt.Sprint(countByPriority(scenarios, "critical")) }</span>
				</div>
				<div class="readout-cell" data-mark="high">
					<span class="engraved">High</span>
					<span class="readout-value">{ fmt.Sprint(countByPriority(scenarios, "high")) }</span>
				</div>
				<div class="readout-cell">
					<span class="engraved">Catch-all</span>
					<span class="readout-value">{ fmt.Sprint(countCatchAll(scenarios)) }</span>
				</div>
			</div>
			<div class="strip-probe">
				<label class="engraved" for="probe-input">Test an alert</label>
				<input
					type="text"
					id="probe-input"
					class="code"
					data-probe-input
					placeholder="alertname=HighCPU, severity=critical"
					autocomplete="off"
				/>
				<button type="submit" class="btn btn-sm">Trace</button>
			</div>
			<div class="strip-action">
				<a href="/scenarios/new" role="button" class="btn btn-primary">New scenario</a>
			</div>
		</form>
		<div class="probe-result" data-probe-result role="status" aria-live="polite" hidden></div>
		<div class="field-toolbar">
			<input
				type="search"
				class="filter-input"
				data-filter-input
				placeholder="Filter by name, label, tool or channel  —  press /"
				aria-label="Filter scenarios"
				autocomplete="off"
			/>
			<span class="field-count" data-filter-count></span>
		</div>
		<div class="field-columns" aria-hidden="true">
			<span class="engraved">#</span>
			<span class="engraved">Path</span>
			<span class="engraved">Catches</span>
			<span class="engraved">Investigates &amp; delivers</span>
			<span class="engraved field-columns-actions"></span>
		</div>
		@ScenarioField(scenarios)
	}
}

templ ScenarioField(scenarios []storage.Scenario) {
	<div class="field" id="scenario-field" data-field>
		if len(scenarios) == 0 {
			<div class="empty">
				<p class="empty-title">No paths configured</p>
				<p>
					Until a scenario exists, every alert that reaches the webhook is dropped.
					A scenario decides which alerts it catches, how the agent investigates them,
					and where the report is sent.
				</p>
				<ol class="empty-steps">
					<li>Create a catch-all path first — no match labels, so nothing is lost.</li>
					<li>Add narrower paths above it for the alerts that deserve their own prompt.</li>
				</ol>
				<a href="/scenarios/new" role="button" class="btn btn-primary">New scenario</a>
			</div>
		} else {
			for i, s := range scenarios {
				@PathRow(s, i, len(scenarios))
			}
			<div class="empty" data-filter-empty hidden>
				<p class="empty-title">No path matches that filter</p>
				<p>Clear the filter to see every path again.</p>
			</div>
		}
	</div>
}

templ PathRow(s storage.Scenario, rank, total int) {
	<article
		class="path"
		id={ fmt.Sprintf("scenario-%d", s.ID) }
		data-id={ fmt.Sprint(s.ID) }
		data-search={ searchIndex(s) }
		data-catch-all={ boolAttr(len(s.Match) == 0) }
	>
		<div class="path-rank">
			<span class="rank-node" title={ fmt.Sprintf("Evaluated %d of %d", rank+1, total) }>{ fmt.Sprint(rank + 1) }</span>
			<span class="mark" data-level={ priorityKey(s.Priority) } aria-hidden="true"></span>
		</div>
		<div class="path-segment path-seg-name">
			<div class="path-name">
				<a href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/edit", s.ID)) }>{ s.Name }</a>
				<span class="mark" data-level={ priorityKey(s.Priority) }>{ priorityLabel(s.Priority) }</span>
			</div>
			<span class="path-prompt" title={ promptPreview(s.Prompt) }>{ promptPreview(s.Prompt) }</span>
		</div>
		<div class="path-segment path-seg-catches">
			<div class="chips">
				if len(s.Match) == 0 {
					<span class="chip" data-open="true">catch-all — anything unmatched above</span>
				} else {
					for _, p := range matchPairs(s.Match) {
						<span class="chip"><span class="chip-key">{ p.Key }</span>{ p.Value }</span>
					}
				}
			</div>
		</div>
		<div class="path-segment path-seg-runs">
			<div class="facts">
				<span><b>Tools</b>{ toolsSummary(s) }</span>
				<span><b>Budget</b>{ s.Timeout }</span>
				if s.SendImages {
					<span><b>Images</b>yes</span>
				} else {
					<span data-off="true"><b>Images</b>no</span>
				}
			</div>
			<div class="chips">
				if len(destinations(s)) == 0 {
					<span class="chip" data-open="true">default channels</span>
				} else {
					for _, d := range destinations(s) {
						<span class="chip"><span class="chip-key">{ d.Key }</span>{ d.Value }</span>
					}
				}
			</div>
		</div>
		<div class="path-actions">
			<div class="path-actions-default">
				<a href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/edit", s.ID)) } role="button" class="btn btn-sm">Edit</a>
				<a href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/copy", s.ID)) } role="button" class="btn btn-sm">Copy</a>
				<button type="button" class="btn btn-sm btn-quiet" data-delete-ask aria-label={ "Delete " + s.Name }>
					@trashIcon()
				</button>
			</div>
			<div class="confirm" role="group" aria-label={ "Confirm deleting " + s.Name }>
				<span>Delete?</span>
				<button
					type="button"
					class="btn btn-sm btn-danger"
					data-delete-confirm
					hx-delete={ fmt.Sprintf("/scenarios/%d", s.ID) }
					hx-target={ fmt.Sprintf("#scenario-%d", s.ID) }
					hx-swap="outerHTML"
				>Yes, delete</button>
				<button type="button" class="btn btn-sm" data-delete-cancel>Keep</button>
			</div>
		</div>
	</article>
}

// --- editor ----------------------------------------------------------------

func formTitle(isEdit bool) string {
	if isEdit {
		return "Edit scenario"
	}
	return "New scenario"
}

func formLede(isEdit bool) string {
	if isEdit {
		return "Changes take effect for the next alert the agent receives."
	}
	return "A new path in the panel: what it catches, how it investigates, where the report lands."
}

templ ScenarioFormPage(s *storage.Scenario, isEdit bool, formErr string) {
	@Layout(formTitle(isEdit), "scenario-form") {
		@PageHead(formTitle(isEdit), formLede(isEdit)) {
			<a href="/scenarios" role="button" class="btn" data-leave>Back to panel</a>
		}
		if formErr != "" {
			@Notice("error", formErr)
		}
		<div class="editor">
			<nav class="rail" data-rail aria-label="Sections">
				<a href="#section-general">General</a>
				<a href="#section-matching">Matching</a>
				<a href="#section-investigation">Investigation</a>
				<a href="#section-delivery">Delivery</a>
				<p class="rail-note">
					Paths are evaluated in order. A path with no match labels catches everything
					that reached it unmatched.
				</p>
			</nav>
			@ScenarioForm(s, isEdit)
		</div>
		@toolPickerDialog()
		@grafanaImportDialog()
	}
}

templ ScenarioForm(s *storage.Scenario, isEdit bool) {
	<form
		if isEdit {
			hx-put={ fmt.Sprintf("/scenarios/%d", s.ID) }
		} else {
			hx-post="/scenarios"
		}
		hx-target="body"
		hx-push-url="/scenarios"
		class="form-stack"
		data-guard-form
	>
		<section class="form-section" id="section-general">
			<div class="form-section-head">
				<h2 class="form-section-title">General</h2>
				<span class="form-section-note">Identity, evaluation order, budgets</span>
			</div>
			<div class="form-grid">
				<div class="field-block">
					<label class="field-label" for="field-name">Name</label>
					<input type="text" id="field-name" name="name" value={ s.Name } required autocomplete="off"/>
					<p class="help">Used in logs, YAML export and notification footers. Must be unique.</p>
				</div>
				<div class="field-block">
					<label class="field-label" for="field-order">
						Order index
						<span class="optional">lower runs first</span>
					</label>
					<input type="number" id="field-order" name="order_index" value={ fmt.Sprint(s.OrderIndex) }/>
					<p class="help">Ties are broken by name. The first path whose labels match wins.</p>
				</div>
			</div>
			<div class="form-grid" style="margin-top:1rem">
				<div class="field-block">
					<label class="field-label" for="field-timeout">Investigation timeout</label>
					<input type="text" id="field-timeout" name="timeout" class="code" value={ s.Timeout } placeholder="2m" required/>
					<div class="presets">
						<button type="button" class="btn btn-sm" data-preset="30s" data-preset-target="field-timeout">30s</button>
						<button type="button" class="btn btn-sm" data-preset="2m" data-preset-target="field-timeout">2m</button>
						<button type="button" class="btn btn-sm" data-preset="5m" data-preset-target="field-timeout">5m</button>
						<button type="button" class="btn btn-sm" data-preset="10m" data-preset-target="field-timeout">10m</button>
					</div>
					<p class="help">Go duration. When it elapses, the agent reports what it has so far.</p>
				</div>
				<div class="field-block">
					<span class="field-label" id="priority-label">Priority</span>
					<div class="segmented" role="radiogroup" aria-labelledby="priority-label">
						<label>
							<input type="radio" name="priority" value="normal" checked?={ priorityKey(s.Priority) == "normal" }/>
							<span class="mark" data-level="normal" aria-hidden="true"></span>
							<span>Normal</span>
						</label>
						<label>
							<input type="radio" name="priority" value="high" checked?={ priorityKey(s.Priority) == "high" }/>
							<span class="mark" data-level="high" aria-hidden="true"></span>
							<span>High</span>
						</label>
						<label>
							<input type="radio" name="priority" value="critical" checked?={ priorityKey(s.Priority) == "critical" }/>
							<span class="mark" data-level="critical" aria-hidden="true"></span>
							<span>Critical</span>
						</label>
					</div>
					<label class="switch" style="margin-top:0.75rem">
						<input type="checkbox" name="send_images" checked?={ s.SendImages }/>
						<span>Attach panel images to the report</span>
					</label>
				</div>
			</div>
		</section>
		<section class="form-section" id="section-matching">
			<div class="form-section-head">
				<h2 class="form-section-title">Matching</h2>
				<span class="form-section-note" data-pairs-badge></span>
			</div>
			<div class="field-block">
				<span class="field-label">Alert labels this path catches</span>
				<div class="pairs" data-pairs></div>
				<p class="pairs-empty" data-pairs-empty hidden>
					No labels — this path is a catch-all and takes every alert that reached it unmatched.
				</p>
				<div class="row-actions">
					<button type="button" class="btn btn-sm" data-pair-add>Add label</button>
					<button type="button" class="btn btn-sm" data-grafana-open>Import from Grafana</button>
				</div>
				<p class="help">
					All labels listed here must be present on the alert with exactly these values.
					The alert may carry other labels.
				</p>
				<textarea name="match" data-pairs-store hidden aria-hidden="true">{ matchText(s.Match) }</textarea>
			</div>
		</section>
		<section class="form-section" id="section-investigation">
			<div class="form-section-head">
				<h2 class="form-section-title">Investigation</h2>
				<span class="form-section-note">What the agent is told, and what it may use</span>
			</div>
			<div class="field-block">
				<label class="field-label" for="field-prompt">Prompt</label>
				<textarea
					id="field-prompt"
					name="prompt"
					class="code"
					rows="4"
					data-autoresize
					required
					placeholder="Investigate the alert. Check the related dashboard, compare against the last 24h, and report the likely cause."
				>{ s.Prompt }</textarea>
				<p class="help">
					Appended to the system prompt for alerts matched by this path. Written for the
					model, not for a human reader.
				</p>
			</div>
			<div class="field-block" style="margin-top:1rem">
				<span class="field-label">
					Allowed tools
					<span class="optional">empty = all</span>
				</span>
				<div class="chips" data-tool-chips></div>
				<div class="row-actions">
					<button type="button" class="btn btn-sm" data-tool-open>Choose tools</button>
				</div>
				<p class="help">
					Restricting tools keeps an investigation focused and cheaper. Tools that no
					connected MCP server offers are marked; they are kept but never called.
				</p>
				<input type="text" name="tools" data-tools-store hidden aria-hidden="true" value={ strings.Join([]string(s.Tools), ", ") }/>
			</div>
		</section>
		<section class="form-section" id="section-delivery">
			<div class="form-section-head">
				<h2 class="form-section-title">Delivery</h2>
				<span class="form-section-note">Overrides the default channels</span>
			</div>
			<div class="form-grid">
				<div class="field-block">
					<label class="field-label" for="field-telegram">
						Telegram
						<span class="optional">optional</span>
					</label>
					<input type="text" id="field-telegram" name="channel_telegram" class="code" value={ s.ChannelTelegram } placeholder="-100123456789"/>
				</div>
				<div class="field-block">
					<label class="field-label" for="field-slack">
						Slack
						<span class="optional">optional</span>
					</label>
					<input type="text" id="field-slack" name="channel_slack" class="code" value={ s.ChannelSlack } placeholder="#alerts"/>
				</div>
			</div>
			<p class="help" style="margin-top:0.75rem">
				Leave both empty to use the channels configured for the agent. A channel set here
				applies only to alerts caught by this path.
			</p>
		</section>
		<div class="row-actions">
			<button type="submit" class="btn btn-primary">
				<span class="btn-idle">
					if isEdit {
						Save changes
					} else {
						Create scenario
					}
				</span>
				<span class="btn-working">
					@spinnerIcon()
					Saving…
				</span>
			</button>
			<a href="/scenarios" role="button" class="btn" data-leave>Cancel</a>
		</div>
	</form>
}

// --- dialogs ---------------------------------------------------------------

templ toolPickerDialog() {
	<dialog id="tool-picker" aria-labelledby="tool-picker-title">
		<div class="dialog-head">
			<h2 id="tool-picker-title" class="form-section-title">MCP tools</h2>
			<button type="button" class="icon-button" data-dialog-close aria-label="Close">
				@closeIcon()
			</button>
		</div>
		<div class="dialog-body">
			<input type="search" data-tool-search placeholder="Search tools" aria-label="Search tools" autocomplete="off"/>
			<p class="help" data-tool-status></p>
			<div class="tool-list" data-tool-list></div>
		</div>
		<div class="dialog-foot">
			<button type="button" class="btn btn-sm" data-tool-clear>Allow all tools</button>
			<button type="button" class="btn btn-primary btn-sm" data-dialog-close>Done</button>
		</div>
	</dialog>
}

templ grafanaImportDialog() {
	<dialog id="grafana-import" aria-labelledby="grafana-import-title">
		<div class="dialog-head">
			<h2 id="grafana-import-title" class="form-section-title">Grafana alert rules</h2>
			<button type="button" class="icon-button" data-dialog-close aria-label="Close">
				@closeIcon()
			</button>
		</div>
		<div class="dialog-body">
			<input type="search" data-grafana-search placeholder="Search by name, group or label" aria-label="Search alert rules" autocomplete="off"/>
			<p class="help" data-grafana-status></p>
			<div class="tool-list" data-grafana-list></div>
		</div>
		<div class="dialog-foot">
			<p class="help">Selecting a rule replaces the labels above with its own.</p>
			<button type="button" class="btn btn-sm" data-dialog-close>Cancel</button>
		</div>
	</dialog>
}

templ trashIcon() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
		<path d="M4.4 6.4h15.2M9.4 6.4V4.4h5.2v2M6.8 6.4l.9 13.2h8.6l.9-13.2M10.2 9.8v6.4M13.8 9.8v6.4"></path>
	</svg>
}

templ closeIcon() {
	<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
		<path d="M6 6l12 12M18 6L6 18"></path>
	</svg>
}
