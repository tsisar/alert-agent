package templates

import (
	"fmt"
	"sort"
	"strings"

	"github.com/tsisar/alert-agent/internal/storage"
)

// --- helpers ---------------------------------------------------------------

type labelPair struct {
	Key   string
	Value string
}

// matchPairs returns the match labels in a stable order.
func matchPairs(m storage.JSONMap) []labelPair {
	pairs := make([]labelPair, 0, len(m))
	for k, v := range m {
		pairs = append(pairs, labelPair{Key: k, Value: v})
	}
	sort.Slice(pairs, func(i, j int) bool { return pairs[i].Key < pairs[j].Key })
	return pairs
}

func matchText(m storage.JSONMap) string {
	pairs := matchPairs(m)
	lines := make([]string, 0, len(pairs))
	for _, p := range pairs {
		lines = append(lines, p.Key+"="+p.Value)
	}
	return strings.Join(lines, "\n")
}

func priorityKey(p string) string {
	switch p {
	case "critical", "high":
		return p
	default:
		return "normal"
	}
}

func priorityLabel(p string) string {
	switch priorityKey(p) {
	case "critical":
		return "Critical"
	case "high":
		return "High"
	default:
		return "Normal"
	}
}

// splitScenarios separates scenarios that match on labels (checked in order)
// from catch-alls, which the matcher only falls back to when nothing matched.
func splitScenarios(scenarios []storage.Scenario) (ordered, fallback []storage.Scenario) {
	for _, s := range scenarios {
		if len(s.Match) == 0 {
			fallback = append(fallback, s)
		} else {
			ordered = append(ordered, s)
		}
	}
	return ordered, fallback
}

// promptPreview trims the prompt to a single scannable line.
func promptPreview(s string) string {
	line := strings.TrimSpace(strings.ReplaceAll(strings.ReplaceAll(s, "\r", " "), "\n", " "))
	for strings.Contains(line, "  ") {
		line = strings.ReplaceAll(line, "  ", " ")
	}
	const limit = 110
	if len(line) > limit {
		return strings.TrimSpace(line[:limit]) + "…"
	}
	return line
}

// searchIndex is the haystack the client-side filter matches against.
func searchIndex(s storage.Scenario) string {
	parts := []string{s.Name, s.Priority, s.Timeout, s.ChannelTelegram, s.ChannelSlack}
	for _, p := range matchPairs(s.Match) {
		parts = append(parts, p.Key+"="+p.Value)
	}
	parts = append(parts, []string(s.Tools)...)
	if len(s.Match) == 0 {
		parts = append(parts, "fallback catch-all")
	}
	return strings.ToLower(strings.Join(parts, " "))
}

func toolsSummary(s storage.Scenario) string {
	switch len(s.Tools) {
	case 0:
		return "All tools"
	case 1:
		return "1 tool"
	default:
		return fmt.Sprintf("%d tools", len(s.Tools))
	}
}

func destinations(s storage.Scenario) []labelPair {
	out := []labelPair{}
	if s.ChannelTelegram != "" {
		out = append(out, labelPair{Key: "Telegram", Value: s.ChannelTelegram})
	}
	if s.ChannelSlack != "" {
		out = append(out, labelPair{Key: "Slack", Value: s.ChannelSlack})
	}
	return out
}

// --- scenario list ---------------------------------------------------------

templ ScenariosPage(scenarios []storage.Scenario) {
	@Layout("Scenarios", "scenarios") {
		@PageHead("Scenarios", "Each alert is handled by the first scenario whose labels it matches, checked top to bottom. If none match, the fallback scenario handles it.") {
			<a href="/scenarios/export.yaml" role="button" class="btn" download="scenarios.yaml">
				@downloadIcon()
				Export YAML
			</a>
			<button type="button" class="btn" onclick="document.getElementById('import-file').click()">
				@uploadIcon()
				Import YAML
			</button>
			<a href="/scenarios/new" role="button" class="btn btn-primary">
				@plusIcon()
				New scenario
			</a>
			<form
				id="import-form"
				hx-post="/scenarios/import"
				hx-target="body"
				hx-push-url="/scenarios"
				hx-encoding="multipart/form-data"
				hidden
			>
				<input
					type="file"
					id="import-file"
					name="file"
					accept=".yaml,.yml"
					onchange="if(this.files.length){htmx.trigger(this.closest('form'),'submit');this.value=''}"
				/>
			</form>
		}
		<section class="card probe" aria-labelledby="probe-title">
			<form class="probe-form" data-probe-form>
				<div class="probe-text">
					<h2 class="card-title" id="probe-title">Test an alert</h2>
					<p class="muted">Enter an alert's labels to see which scenario would handle it.</p>
				</div>
				<div class="probe-controls">
					<input
						type="text"
						id="probe-input"
						class="mono"
						data-probe-input
						placeholder="alertname=HighCPU, severity=critical"
						aria-labelledby="probe-title"
						autocomplete="off"
						spellcheck="false"
					/>
					<button type="submit" class="btn">
						@playIcon()
						Run test
					</button>
				</div>
			</form>
			<div class="probe-result" data-probe-result role="status" aria-live="polite" hidden></div>
		</section>
		@ScenarioList(scenarios)
	}
}

templ ScenarioList(scenarios []storage.Scenario) {
	<section class="card list" id="scenario-list" aria-label="Scenarios">
		if len(scenarios) == 0 {
			<div class="empty">
				<h2 class="empty-title">No scenarios yet</h2>
				<p>
					Until a scenario exists, every alert that reaches the webhook is dropped.
					Start with a fallback scenario (no match labels) so nothing is lost, then add
					specific scenarios for alerts that need their own instructions.
				</p>
				<a href="/scenarios/new" role="button" class="btn btn-primary">
					@plusIcon()
					New scenario
				</a>
			</div>
		} else {
			<div class="list-toolbar">
				<label class="search">
					@searchIcon()
					<input
						type="search"
						data-filter-input
						placeholder="Filter by name, label, tool or channel"
						aria-label="Filter scenarios"
						autocomplete="off"
					/>
					<kbd title="Press / to filter">/</kbd>
				</label>
				<span class="list-count" data-filter-count></span>
			</div>
			<div class="table-wrap">
				<table class="scn-table" data-field>
					<thead>
						<tr>
							<th scope="col" class="col-order">Order</th>
							<th scope="col">Scenario</th>
							<th scope="col">Matches labels</th>
							<th scope="col">Investigation</th>
							<th scope="col">Sends to</th>
							<th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
						</tr>
					</thead>
					@scenarioGroups(scenarios)
				</table>
			</div>
			<div class="empty empty-inline" data-filter-empty hidden>
				<p class="empty-title">No scenario matches that filter</p>
				<p>Press Esc to clear it.</p>
			</div>
		}
	</section>
}

templ scenarioGroups(scenarios []storage.Scenario) {
	{{ ordered, fallback := splitScenarios(scenarios) }}
	<tbody>
		for i, s := range ordered {
			@ScenarioRow(s, i, len(ordered))
		}
		if len(ordered) == 0 {
			<tr class="group-note">
				<td colspan="6">No label-matching scenarios. Every alert goes to the fallback.</td>
			</tr>
		}
	</tbody>
	<tbody class="fallback-group">
		<tr class="group-head">
			<th colspan="6" scope="rowgroup">
				<span class="group-title">Fallback</span>
				<span class="muted">Handles alerts that no scenario above matches.</span>
				if len(fallback) > 1 {
					<span class="group-warn">
						@alertIcon()
						{ fmt.Sprintf("%d fallback scenarios: only the last one is ever used.", len(fallback)) }
					</span>
				}
			</th>
		</tr>
		for _, s := range fallback {
			@ScenarioRow(s, -1, 0)
		}
		if len(fallback) == 0 {
			<tr class="group-note" data-level="warn">
				<td colspan="6">
					<span class="group-warn">
						@alertIcon()
						No fallback. Alerts that match no scenario are dropped.
					</span>
					<a href="/scenarios/new" class="link">Create a scenario without labels</a>
				</td>
			</tr>
		}
	</tbody>
}

// ScenarioRow renders one scenario. pos is its index among the ordered
// scenarios, or -1 for a fallback (catch-all) scenario, which has no position.
templ ScenarioRow(s storage.Scenario, pos, total int) {
	<tr
		class="scn-row"
		id={ fmt.Sprintf("scenario-%d", s.ID) }
		data-id={ fmt.Sprint(s.ID) }
		data-search={ searchIndex(s) }
	>
		<td class="col-order">
			if pos >= 0 {
				<div class="order">
					<span class="order-num" data-rank>{ fmt.Sprint(pos + 1) }</span>
					<span class="order-move">
						<button
							type="button"
							class="btn btn-icon btn-ghost btn-xs"
							aria-label={ "Move " + s.Name + " up" }
							title="Move up"
							disabled?={ pos == 0 }
							hx-post={ fmt.Sprintf("/scenarios/%d/move?dir=up", s.ID) }
							hx-target="#scenario-list"
							hx-select="#scenario-list"
							hx-swap="outerHTML"
							data-move="up"
						>
							@arrowUpIcon()
						</button>
						<button
							type="button"
							class="btn btn-icon btn-ghost btn-xs"
							aria-label={ "Move " + s.Name + " down" }
							title="Move down"
							disabled?={ pos == total-1 }
							hx-post={ fmt.Sprintf("/scenarios/%d/move?dir=down", s.ID) }
							hx-target="#scenario-list"
							hx-select="#scenario-list"
							hx-swap="outerHTML"
							data-move="down"
						>
							@arrowDownIcon()
						</button>
					</span>
				</div>
			} else {
				<span class="order-fallback" title="Used when nothing else matches">—</span>
			}
		</td>
		<td class="col-name">
			<div class="scn-name">
				<a href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/edit", s.ID)) }>{ s.Name }</a>
				<span class="badge" data-priority={ priorityKey(s.Priority) }>{ priorityLabel(s.Priority) }</span>
			</div>
			<p class="scn-prompt" title={ promptPreview(s.Prompt) }>{ promptPreview(s.Prompt) }</p>
		</td>
		<td class="col-match" data-label="Matches">
			if len(s.Match) == 0 {
				<span class="muted">Any alert</span>
			} else {
				<div class="chips">
					for _, p := range matchPairs(s.Match) {
						<span class="chip"><span class="chip-key">{ p.Key }</span>{ p.Value }</span>
					}
				</div>
			}
		</td>
		<td class="col-run" data-label="Investigation">
			<ul class="facts">
				<li>{ toolsSummary(s) }</li>
				<li>Timeout <span class="mono">{ s.Timeout }</span></li>
				if s.SendImages {
					<li>Panel images</li>
				}
			</ul>
		</td>
		<td class="col-dest" data-label="Sends to">
			if len(destinations(s)) == 0 {
				<span class="muted">Default channels</span>
			} else {
				<ul class="facts">
					for _, d := range destinations(s) {
						<li>{ d.Key } <span class="mono">{ d.Value }</span></li>
					}
				</ul>
			}
		</td>
		<td class="col-actions">
			<div class="row-actions" data-actions>
				<a href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/edit", s.ID)) } role="button" class="btn btn-sm">
					@pencilIcon()
					Edit
				</a>
				<a
					href={ templ.SafeURL(fmt.Sprintf("/scenarios/%d/copy", s.ID)) }
					role="button"
					class="btn btn-sm btn-icon"
					aria-label={ "Duplicate " + s.Name }
					title="Duplicate"
				>
					@copyIcon()
				</a>
				<button
					type="button"
					class="btn btn-sm btn-icon btn-danger-quiet"
					data-delete-ask
					aria-label={ "Delete " + s.Name }
					title="Delete"
				>
					@trashIcon()
				</button>
			</div>
			<div class="row-confirm" role="group" aria-label={ "Confirm deleting " + s.Name }>
				<span>Delete this scenario?</span>
				<button
					type="button"
					class="btn btn-sm btn-danger"
					data-delete-confirm
					hx-delete={ fmt.Sprintf("/scenarios/%d", s.ID) }
					hx-target="#scenario-list"
					hx-select="#scenario-list"
					hx-swap="outerHTML"
				>Delete</button>
				<button type="button" class="btn btn-sm" data-delete-cancel>Cancel</button>
			</div>
		</td>
	</tr>
}

// --- editor ----------------------------------------------------------------

func formTitle(isEdit bool) string {
	if isEdit {
		return "Edit scenario"
	}
	return "New scenario"
}

templ ScenarioFormPage(s *storage.Scenario, isEdit bool, formErr string) {
	@Layout(formTitle(isEdit), "scenario-form") {
		<nav class="crumbs" aria-label="Breadcrumb">
			<a href="/scenarios" data-leave>
				@chevronLeftIcon()
				Scenarios
			</a>
		</nav>
		@PageHead(formTitle(isEdit), "Changes apply to the next alert the agent receives.") {
		}
		if formErr != "" {
			@Notice("error", formErr)
		}
		@ScenarioForm(s, isEdit)
		@toolPickerDialog()
		@grafanaImportDialog()
	}
}

templ ScenarioForm(s *storage.Scenario, isEdit bool) {
	<form
		if isEdit {
			hx-put={ fmt.Sprintf("/scenarios/%d", s.ID) }
		} else {
			hx-post="/scenarios"
		}
		hx-target="body"
		hx-push-url="/scenarios"
		class="editor"
		data-guard-form
	>
		<section class="card form-card" aria-labelledby="sec-basics">
			<header class="form-card-head">
				<h2 class="card-title" id="sec-basics">Basics</h2>
			</header>
			<div class="form-card-body">
				<div class="form-row">
					<div class="field">
						<label for="field-name">Name</label>
						<input type="text" id="field-name" name="name" value={ s.Name } required autocomplete="off"/>
						<p class="help">Shown in logs, the YAML export and report footers. Must be unique.</p>
					</div>
					<div class="field field-narrow">
						<label for="field-order">Order</label>
						<input type="number" id="field-order" name="order_index" value={ fmt.Sprint(s.OrderIndex) }/>
						<p class="help">Lower numbers are checked first. You can also reorder with the arrows on the scenario list.</p>
					</div>
				</div>
				<div class="field">
					<span class="field-label" id="priority-label">Priority</span>
					<div class="segmented" role="radiogroup" aria-labelledby="priority-label">
						<label>
							<input type="radio" name="priority" value="normal" checked?={ priorityKey(s.Priority) == "normal" }/>
							<span class="dot" data-priority="normal" aria-hidden="true"></span>
							Normal
						</label>
						<label>
							<input type="radio" name="priority" value="high" checked?={ priorityKey(s.Priority) == "high" }/>
							<span class="dot" data-priority="high" aria-hidden="true"></span>
							High
						</label>
						<label>
							<input type="radio" name="priority" value="critical" checked?={ priorityKey(s.Priority) == "critical" }/>
							<span class="dot" data-priority="critical" aria-hidden="true"></span>
							Critical
						</label>
					</div>
				</div>
			</div>
		</section>
		<section class="card form-card" aria-labelledby="sec-match">
			<header class="form-card-head">
				<h2 class="card-title" id="sec-match">Which alerts</h2>
				<span class="badge" data-pairs-badge></span>
			</header>
			<div class="form-card-body">
				<p class="help help-lead">
					The alert must carry every label listed here, with exactly these values. It may carry other labels too.
				</p>
				<div class="pairs" data-pairs></div>
				<p class="pairs-empty" data-pairs-empty hidden>
					<strong>No labels: this is a fallback scenario.</strong>
					It handles any alert that no other scenario matches.
				</p>
				<div class="btn-row">
					<button type="button" class="btn btn-sm" data-pair-add>
						@plusIcon()
						Add label
					</button>
					<button type="button" class="btn btn-sm" data-grafana-open>
						@downloadIcon()
						Import from Grafana rule
					</button>
				</div>
				<textarea name="match" data-pairs-store hidden aria-hidden="true">{ matchText(s.Match) }</textarea>
			</div>
		</section>
		<section class="card form-card" aria-labelledby="sec-invest">
			<header class="form-card-head">
				<h2 class="card-title" id="sec-invest">Investigation</h2>
			</header>
			<div class="form-card-body">
				<div class="field">
					<label for="field-prompt">Instructions for the agent</label>
					<textarea
						id="field-prompt"
						name="prompt"
						class="mono"
						rows="5"
						data-autoresize
						required
						placeholder="Investigate the alert. Check the related dashboard, compare against the last 24h, and report the likely cause."
					>{ s.Prompt }</textarea>
					<p class="help">Added to the system prompt for alerts this scenario handles.</p>
				</div>
				<div class="field">
					<span class="field-label">Allowed tools</span>
					<div class="tool-summary">
						<div class="chips" data-tool-chips></div>
						<button type="button" class="btn btn-sm" data-tool-open>Choose tools…</button>
					</div>
					<p class="help">Leave empty to allow every tool. Tools that no connected MCP server offers are marked and never called.</p>
					<input type="text" name="tools" data-tools-store hidden aria-hidden="true" value={ strings.Join([]string(s.Tools), ", ") }/>
				</div>
				<div class="field">
						<label for="field-timeout">Timeout</label>
						<div class="input-with-presets">
							<input type="text" id="field-timeout" name="timeout" class="mono" value={ s.Timeout } placeholder="2m" required spellcheck="false"/>
							<div class="presets" role="group" aria-label="Timeout presets">
								<button type="button" class="btn btn-sm" data-preset="30s" data-preset-target="field-timeout">30s</button>
								<button type="button" class="btn btn-sm" data-preset="2m" data-preset-target="field-timeout">2m</button>
								<button type="button" class="btn btn-sm" data-preset="5m" data-preset-target="field-timeout">5m</button>
								<button type="button" class="btn btn-sm" data-preset="10m" data-preset-target="field-timeout">10m</button>
							</div>
						</div>
						<p class="help">When it runs out, the agent reports what it has found so far.</p>
				</div>
				<label class="switch">
					<input type="checkbox" name="send_images" checked?={ s.SendImages }/>
					<span class="switch-text">
						<span>Attach Grafana panel images to the report</span>
					</span>
				</label>
			</div>
		</section>
		<section class="card form-card" aria-labelledby="sec-delivery">
			<header class="form-card-head">
				<h2 class="card-title" id="sec-delivery">Delivery</h2>
			</header>
			<div class="form-card-body">
				<p class="help help-lead">Leave both empty to use the agent's default channels.</p>
				<div class="form-row">
					<div class="field">
						<label for="field-telegram">Telegram chat ID</label>
						<input type="text" id="field-telegram" name="channel_telegram" class="mono" value={ s.ChannelTelegram } placeholder="-100123456789" spellcheck="false"/>
					</div>
					<div class="field">
						<label for="field-slack">Slack channel</label>
						<input type="text" id="field-slack" name="channel_slack" class="mono" value={ s.ChannelSlack } placeholder="#alerts" spellcheck="false"/>
					</div>
				</div>
			</div>
		</section>
		<div class="save-bar">
			<div class="save-bar-inner">
				<span class="save-state" data-save-state aria-live="polite">
					if isEdit {
						No unsaved changes
					} else {
						Not created yet
					}
				</span>
				<div class="btn-row">
					<a href="/scenarios" role="button" class="btn" data-leave>Cancel</a>
					<button type="submit" class="btn btn-primary">
						<span class="btn-idle">
							if isEdit {
								Save changes
							} else {
								Create scenario
							}
						</span>
						<span class="btn-working">
							@spinnerIcon()
							Saving…
						</span>
						<kbd class="kbd-on-primary" aria-hidden="true">Ctrl S</kbd>
					</button>
				</div>
			</div>
		</div>
	</form>
}

// --- dialogs ---------------------------------------------------------------

templ toolPickerDialog() {
	<dialog id="tool-picker" aria-labelledby="tool-picker-title">
		<div class="dialog-head">
			<h2 id="tool-picker-title" class="card-title">Allowed tools</h2>
			<button type="button" class="btn btn-icon btn-ghost" data-dialog-close aria-label="Close">
				@closeIcon()
			</button>
		</div>
		<div class="dialog-body">
			<label class="search">
				@searchIcon()
				<input type="search" data-tool-search placeholder="Search tools" aria-label="Search tools" autocomplete="off"/>
			</label>
			<p class="help" data-tool-status></p>
			<div class="pick-list" data-tool-list></div>
		</div>
		<div class="dialog-foot">
			<button type="button" class="btn" data-tool-clear>Allow all tools</button>
			<button type="button" class="btn btn-primary" data-dialog-close>Done</button>
		</div>
	</dialog>
}

templ grafanaImportDialog() {
	<dialog id="grafana-import" aria-labelledby="grafana-import-title">
		<div class="dialog-head">
			<h2 id="grafana-import-title" class="card-title">Import labels from a Grafana rule</h2>
			<button type="button" class="btn btn-icon btn-ghost" data-dialog-close aria-label="Close">
				@closeIcon()
			</button>
		</div>
		<div class="dialog-body">
			<label class="search">
				@searchIcon()
				<input type="search" data-grafana-search placeholder="Search by name, group or label" aria-label="Search alert rules" autocomplete="off"/>
			</label>
			<p class="help" data-grafana-status></p>
			<div class="pick-list" data-grafana-list></div>
		</div>
		<div class="dialog-foot">
			<p class="help">Choosing a rule replaces the current labels with the rule's own.</p>
			<button type="button" class="btn" data-dialog-close>Cancel</button>
		</div>
	</dialog>
}
