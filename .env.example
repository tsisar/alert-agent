# HTTP server
HTTP_ADDR=:8080

# MCP servers config (.mcp.json path)
MCP_CONFIG_PATH=.mcp.json

# Database (sqlite, postgres, mysql)
DATABASE_DRIVER=sqlite
DATABASE_DSN=./alert-agent.db
# DATABASE_DRIVER=postgres
# DATABASE_DSN=host=localhost user=agent password=secret dbname=alertagent sslmode=disable
# DATABASE_DRIVER=mysql
# DATABASE_DSN=agent:secret@tcp(localhost:3306)/alertagent?parseTime=true

# LLM provider: openai | anthropic
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=
# Empty = provider default (openai→gpt-4o, anthropic→claude-opus-4-8)
LLM_MODEL=
LLM_MAX_TOKENS=4096
# Reasoning/thinking: empty = off; low|medium|high (openai reasoning models / anthropic adaptive thinking)
LLM_REASONING_EFFORT=
LLM_CONTEXT_LIMIT=0

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_DEFAULT_CHANNEL=

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_DEFAULT_CHANNEL=

# Redis (optional, empty = in-memory dedup and queue, e.g. "redis://localhost:6379")
REDIS_URL=

# Alert deduplication cooldown (e.g. 48h, 1h30m)
ALERT_COOLDOWN=48h

# Logging (github.com/tsisar/extended-log-go)
LOG_SAVE=false
LOG_LEVEL=debug
LOG_TIMEZONE=UTC
LOG_SHOW_CALLER=true
